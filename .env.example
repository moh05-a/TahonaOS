# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=tahona
POSTGRES_USER=tahona
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- API ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=tahona;Username=tahona;Password=change-me
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT__SECRET=
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Cors__Origins=http://localhost:5173
# Address of the web app, used in invitation and password-reset links.
APP__PUBLICURL=http://localhost:5173
# Shown to clinic administrators under Settings → Subscription.
# APP__SUPPORTCONTACT=support@example.com
# APP__PAYMENTINSTRUCTIONS=Pay by CliQ to alias EXAMPLE, then send the receipt to support.

# --- Stored secrets ---
# Encrypts the WhatsApp tokens clinics save under Settings. 32 random bytes, base64: `openssl rand -base64 32`.
# Without it clinics cannot connect their own number. Keep it safe: if it is lost or changed, clinics must reconnect.
SECRETS__ENCRYPTIONKEY=

# --- Optional: e-mail (invitations and "forgot password") ---
# Without a mail server, an operator passes invitation and reset links on by hand.
# EMAIL__HOST=smtp.example.com
# EMAIL__PORT=587
# EMAIL__USERNAME=
# EMAIL__PASSWORD=
# EMAIL__FROM=TahonaOS <no-reply@example.com>
# EMAIL__SECURITY=starttls        # starttls (default) | ssl | none (local test servers only)

# --- Optional: uploaded files in an S3-compatible bucket (default: a local folder / Docker volume) ---
# STORAGE__PROVIDER=s3
# STORAGE__S3__BUCKET=
# STORAGE__S3__REGION=us-east-1
# STORAGE__S3__ACCESSKEY=
# STORAGE__S3__SECRETKEY=
# STORAGE__S3__SERVICEURL=        # only for S3-compatible services (R2, Spaces, MinIO); leave empty for AWS
# STORAGE__S3__FORCEPATHSTYLE=false

# --- Demo data (Development only: creates a sample clinic on first start) ---
# The API refuses to start with demo data outside Development unless SEED__ALLOWOUTSIDEDEVELOPMENT=true
# (only for a deliberate public demo site, never next to real clinics).
SEED__DEMODATA=true
SEED__DEMOPASSWORD=ChangeMe-Demo1

# --- Reverse proxy ---
# CIDR ranges of the proxies allowed to set X-Forwarded-For (comma separated). Needed for per-IP login limits
# and correct audit-log addresses when the API runs behind nginx or a load balancer. Loopback is always trusted.
# PROXY__TRUSTEDNETWORKS=172.16.0.0/12

# --- Optional: AI assistant & clinical note structuring ---
# Provider: gemini (default; works with a free Google AI Studio key from https://aistudio.google.com/apikey) or claude.
# Without a key the assistant runs in built-in (rule-based) mode.
# Gemini's FREE tier terms say submitted content is used to improve Google products, may be read by reviewers,
# and must not contain personal information. Do not use a free key for a real clinic.
AI__PROVIDER=gemini
AI__APIKEY=
# Leave empty for the provider default (gemini-3.8-flash / claude-opus-5-5). A lighter free option: gemini-3.5-flash-lite
AI__MODEL=
# What patient-level data the AI provider may receive:
#   minimized (default)  file numbers instead of names and phone numbers
#   off                  clinic-wide totals only; clinical-note structuring stays on the server
#   full                 names and phone numbers; only with a data-processing agreement covering patient data
AI__PATIENTDATA=minimized

# --- Optional: WhatsApp Business Cloud API (Meta) ---
# Each clinic connects its own number under Settings → Integrations (needs SECRETS__ENCRYPTIONKEY).
# Without a connected number, messages open in WhatsApp (wa.me) for staff to send manually.
# The webhook (https://<host>/api/webhooks/whatsapp) is shared by all clinics and needs these two:
WHATSAPP__WEBHOOKVERIFYTOKEN=
WHATSAPP__APPSECRET=
# Deployment-wide credentials, for a single-clinic installation only. Leave empty when clinics connect their own numbers.
WHATSAPP__ACCESSTOKEN=
WHATSAPP__PHONENUMBERID=

# --- Background follow-up automation ---
AUTOMATION__ENABLED=true
AUTOMATION__INTERVALMINUTES=15
