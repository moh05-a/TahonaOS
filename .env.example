# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_DB=tahona
POSTGRES_USER=tahona
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- API ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=tahona;Username=tahona;Password=change-me
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT__SECRET=
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Cors__Origins=http://localhost:5173

# --- Demo data (creates a sample clinic with ~70 patients on first start) ---
SEED__DEMODATA=true
SEED__DEMOPASSWORD=ChangeMe-Demo1

# --- Optional: AI assistant & clinical note structuring ---
# Provider: gemini (default; works with a free Google AI Studio key from https://aistudio.google.com/apikey) or claude.
# Without a key the assistant runs in built-in (rule-based) mode.
# Note: on Gemini's FREE tier Google may use submitted content to improve its products. Use a paid key for real patient data.
AI__PROVIDER=gemini
AI__APIKEY=
# Leave empty for the provider default (gemini-3.8-flash / claude-opus-5-5). A lighter free option: gemini-3.5-flash-lite
AI__MODEL=

# --- Optional: WhatsApp Business Cloud API (Meta) ---
# Without credentials messages open in WhatsApp (wa.me) for staff to send manually.
WHATSAPP__ACCESSTOKEN=
WHATSAPP__PHONENUMBERID=
WHATSAPP__WEBHOOKVERIFYTOKEN=
WHATSAPP__APPSECRET=

# --- Background follow-up automation ---
AUTOMATION__ENABLED=true
AUTOMATION__INTERVALMINUTES=15
